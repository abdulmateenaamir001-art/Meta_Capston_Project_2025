# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values
# ============================================

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Booking Service
VITE_BOOKING_API_ENDPOINT=http://localhost:3000/api/bookings

# Restaurant Details
VITE_RESTAURANT_NAME=Little Lemon
VITE_RESTAURANT_EMAIL=contact@littlelemon.com

# Feature Flags
VITE_ENABLE_BOOKINGS=true
VITE_ENABLE_ONLINE_ORDERING=false

# Environment (development, production)
VITE_ENVIRONMENT=development
